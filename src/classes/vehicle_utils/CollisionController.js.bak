/**
 * ç¢°æ??§åˆ¶??- ç°¡å???v3
 * è² è²¬ï¼? * 1. æª¢æŸ¥?ˆè??œæ­¢ï¼ˆç????¨ç?ç«‹å³?œæ­¢ï¼Œé??ˆèµ°?°å?æ­¢ç??å?æ­¢ï?
 * 2. æª¢æŸ¥?æ–¹ç¢°æ?ï¼ˆè???< TARGET_SPACING ?‚å?æ­¢æ??•è?ï¼? * 3. è¿”å??œæ­¢?–è?è¡Œç??‡ä»¤
 */

// ?¯ ?¯é?ç½®å??¸ï??¨å?ï¼?const COLLISION_CONFIG = {
  TRAFFIC_LIGHT_CHECK_DISTANCE: 100, // ?ˆè??œæ­¢è·é›¢ï¼šç•¶è»Šè??¢å?æ­¢ç? < æ­¤å€¼æ?ï¼Œæª¢?¥ç??Ÿæ˜¯?¦é?è¦å?æ­?  TARGET_SPACING: 15, // ?¯ ?±è¥¿?‘ç›®æ¨™é?è·ï?pxï¼?  TARGET_SPACING_VERTICAL: 25, // ?¯ ?—å??‘ç›®æ¨™é?è·ï?pxï¼? ?—å??‘è??´çŸ­ï¼Œé?è¦ç?å¤§ç??“è?ä¾†ä??è?è¦ºä???  CRAWL_SPEED: 0.02, // ?•è??Ÿåº¦ï¼šç•¶è·é›¢ < TARGET_SPACING ?‚ç?è·Ÿéš¨?Ÿåº¦ï¼ˆé?ä½è‡³ 0.02 ä»¥æ?é«˜ç²¾åº¦ï?
  DETECTION_RANGE: 300, // ç¢°æ?æª¢æ¸¬ç¯„å?ï¼šæª¢?¥å??¹æ?å¤?300px ?§ç?è»Šè?
}

export class CollisionController {
  constructor(vehicle, trafficController = null) {
    this.vehicle = vehicle
    this.trafficController = trafficController
    this.lastCheckTime = 0
    this.checkInterval = 10 // æ¯?10ms æª¢æŸ¥ä¸€æ¬¡ï?é«˜é »?‡ï?5 ?æ??‡ï??²æ­¢? è??‚ç©¿?ï?
  }

  /**
   * è¨­ç½®äº¤é€šç??§åˆ¶?¨ï?å¤–éƒ¨æ³¨å…¥ï¼?   */
  setTrafficController(trafficController) {
    this.trafficController = trafficController
  }

  /**
   * ç°¡å??ˆç¢°?æª¢??   * ?è¼¯ï¼?   * 1. ?ˆè??œæ­¢ï¼ˆç?/é»??¨ç?ï¼‰â? ?œæ­¢
   * 2. è·é›¢ < TARGET_SPACING ???œæ­¢?–è?è¡?   * 3. è·é›¢ >= TARGET_SPACING ???ªç”±? é€?   *
   * è¿”å??¼ï?{ targetSpeed, reason, distance, frontVehicle, ... } ??null
   */
  checkSimpleCollision(allVehicles) {
    const now = Date.now()
    if (now - this.lastCheckTime < this.checkInterval) {
      return null
    }
    this.lastCheckTime = now

    // ç¬¬ä?æ­¥ï?æª¢æŸ¥?ˆè??œæ­¢
    const trafficLightStop = this._checkTrafficLightStop()
    if (trafficLightStop) {
      return trafficLightStop
    }

    // ç¬¬ä?æ­¥ï?æª¢æŸ¥?æ–¹ç¢°æ?
    const frontVehicle = this._findClosestFrontVehicle(allVehicles)
    if (!frontVehicle) {
      return null // æ²’æ??è?
    }

    const distance = this._getDistance(this.vehicle, frontVehicle)
    const frontSpeed = frontVehicle.movementTimeline?.timeScale() || 0

    // ?¯ ?¹æ??¹å??¸æ?ä¸å???TARGET_SPACING
    // ?—å??‘è??´çŸ­ï¼Œé?è¦ç?å¤§ç??“è?ä¿æ?è¦–è¦ºä¸€??    const targetSpacing =
      this.vehicle.direction === 'south' || this.vehicle.direction === 'north'
        ? COLLISION_CONFIG.TARGET_SPACING_VERTICAL
        : COLLISION_CONFIG.TARGET_SPACING

    // ?¯ ?©æ®µ?è¼¯ï¼?    // 1. è·é›¢ < TARGET_SPACINGï¼šå?æ­¢æ??•è?ï¼ˆæ?å°å??¨é?è·ï?
    // 2. è·é›¢ >= TARGET_SPACINGï¼šè‡ª?±å???
    if (distance < targetSpacing) {
      // è·é›¢ < TARGET_SPACINGï¼šå¤ªè¿‘ä?ï¼Œå??ˆå?æ­¢æ??•è?
      if (frontSpeed <= 0.01) {
        // ?è??œæ­¢äº†ï??‘ä??œæ­¢
        return {
          targetSpeed: 0,
          reason: `?œæ­¢ï¼šå?è»Šå?æ­¢ï?è·é›¢${distance.toFixed(1)}px < ?€å°é?è·?{targetSpacing}px`,
          distance: distance,
          frontVehicle: frontVehicle,
          frontVehicleIsMoving: false,
          action: 'stop',
        }
      } else {
        // ?è??¨ç§»?•ï??•è?è·Ÿéš¨
        return {
          targetSpeed: COLLISION_CONFIG.CRAWL_SPEED,
          reason: `?•è?ï¼šè???{distance.toFixed(1)}px < ?€å°é?è·?{targetSpacing}pxï¼Œè??¨ç¶­?è??¢`,
          distance: distance,
          frontVehicle: frontVehicle,
          frontVehicleIsMoving: true,
          action: 'crawl',
        }
      }
    }

    // è·é›¢ >= TARGET_SPACINGï¼šè‡ª?±å???    return {
      targetSpeed: undefined, // ?è¨±?ªç”±? é€?      reason: `?ªç”±ï¼šè???{distance.toFixed(1)}px >= ?€å°é?è·?{targetSpacing}px`,
      distance: distance,
      frontVehicle: frontVehicle,
      frontVehicleIsMoving: frontSpeed > 0.01,
      action: 'free',
    }
  }

  /**
   * æª¢æŸ¥?ˆè??œæ­¢è¦å?
   * ?è¼¯ï¼?   * - ç´…ç??å…¨ç´???ç«‹å³?œæ­¢ï¼ˆä?ç®¡è??¢ï?
   * - é»ƒç? ???è¨±ç¹¼ç?èµ°ï?? è??œæ­¢ç·šæ??å?æ­¢ï?< 100px ?‚å?æ­¢ï?
   * - ç¶ ç??å·¦è½‰ç??????¾è?
   * è¿”å??¼ï?{ targetSpeed=0, reason, distance, action='traffic_light_stop' } ??null
   */
  _checkTrafficLightStop() {
    if (!this.trafficController) {
      return null
    }

    // ?²å??¶å??ˆè??€??    const lightState = this.trafficController.getCurrentLightState(this.vehicle.direction)
    const distanceToStopLine = this.vehicle.position?.distance || Infinity

    // ï¿?ç´…ç??å…¨ç´???ç«‹å³?œæ­¢ï¼ˆä?ç®¡è??¢å?? ï?
    if (lightState === 'red' || lightState === 'allRed') {
      return {
        targetSpeed: 0,
        reason: `?ˆè??œæ­¢ï¼?{lightState}ï¼Œè??¢å?æ­¢ç?${Number.isFinite(distanceToStopLine) ? distanceToStopLine.toFixed(1) : 'Infinity'}px`,
        distance: distanceToStopLine,
        lightState: lightState,
        action: 'traffic_light_stop',
      }
    }

    // ?Ÿ¡ é»ƒç? ???è¨±ç¹¼ç?èµ°ï?ä½†é?è¿‘å?æ­¢ç?ï¼? TRAFFIC_LIGHT_CHECK_DISTANCEï¼‰æ??œæ­¢
    if (lightState === 'yellow') {
      if (Number.isFinite(distanceToStopLine) && distanceToStopLine < COLLISION_CONFIG.TRAFFIC_LIGHT_CHECK_DISTANCE) {
        // ? è??œæ­¢ç·šä?ï¼Œå?æ­?        return {
          targetSpeed: 0,
          reason: `é»ƒç??œæ­¢ï¼šè??¢å?æ­¢ç?${distanceToStopLine.toFixed(1)}px < ${COLLISION_CONFIG.TRAFFIC_LIGHT_CHECK_DISTANCE}px`,
          distance: distanceToStopLine,
          lightState: lightState,
          action: 'traffic_light_stop',
        }
      }
      // ?„å?? ï??è¨±ç¹¼ç?èµ?      return null
    }

    // ?Ÿ¢ ç¶ ç??–å·¦è½‰ç??ˆï??è¨±?šé?
    return null
  } /**
   * ?¾å??¹æ?è¿‘ç?è»Šè?
   */
  _findClosestFrontVehicle(allVehicles) {
    let closest = null
    let minDistance = Infinity

    const myPos = this.vehicle.getCurrentPosition()
    if (!myPos) return null

    for (const other of allVehicles) {
      // ?Œæ–¹?‘å?è»Šé?
      if (
        other.id === this.vehicle.id ||
        other.direction !== this.vehicle.direction ||
        other.laneNumber !== this.vehicle.laneNumber
      ) {
        continue
      }

      const otherPos = other.getCurrentPosition()
      if (!otherPos) continue

      const distance = this._getDistance(this.vehicle, other)

      // ?ªç??æ–¹?„è?ï¼ˆè???> 0ï¼‰ä??¨æª¢?¥ç??å…§ï¼? DETECTION_RANGEï¼?      if (distance > 0 && distance < COLLISION_CONFIG.DETECTION_RANGE && distance < minDistance) {
        closest = other
        minDistance = distance
      }
    }

    return closest
  }

  /**
   * è¨ˆç??©è?ä¹‹é??„è??¢ï?ä¸­å??°ä¸­å¿ƒï?
   * ?¶å??¹æ?è»Šå¯¬åº¦èª¿?´ç‚º?Œé??Œåˆ°?Šç??„å¯¦?›é?è·ã€?   *
   * ? ï? ?è?ï¼šå??—å??Œæ±è¥¿å?è»Šç??·åº¦ä¸å?
   * ?±è¥¿?‘ï?width = 25-35pxï¼ˆé•·è»¸ï?
   * ?—å??‘ï?height = 15-20pxï¼ˆçŸ­è»¸ï??‹è?å¾Œä??ºé•·è»¸ï?
   * ?ºä??ä??´ç?è¦–è¦º?“è?ï¼Œæ??‘åŸº?¼å?è»Šç??¹å?ä¾†è?ç®—é•·åº?   */
  _getDistance(vehicle1, vehicle2) {
    const pos1 = vehicle1.getCurrentPosition()
    const pos2 = vehicle2.getCurrentPosition()

    if (!pos1 || !pos2) return Infinity

    // ä¸­å??°ä¸­å¿ƒç?è·é›¢
    let centerDistance = 0
    switch (vehicle1.direction) {
      case 'east':
        centerDistance = pos2.x - pos1.x
        break
      case 'west':
        centerDistance = pos1.x - pos2.x
        break
      case 'south':
        centerDistance = pos2.y - pos1.y
        break
      case 'north':
        centerDistance = pos1.y - pos2.y
        break
      default:
        return Infinity
    }

    // ?²å??©è??„é?ç½?    const config1 = vehicle1.getVehicleConfig()
    const config2 = vehicle2.getVehicleConfig()

    // ?¹æ??¹å?ç¢ºå??Œç¸±è»¸é•·åº¦ã€ï??é€²æ–¹?‘ç??·åº¦ï¼?    let vehicle1Length = 0
    let vehicle2Length = 0

    switch (vehicle1.direction) {
      case 'east':
      case 'west':
        // æ°´å¹³ç§»å?ï¼šwidth ?¯ç¸±è»¸ï??é€²æ–¹?‘ç??·åº¦ï¼?        vehicle1Length = config1.width
        vehicle2Length = config2.width
        break
      case 'south':
      case 'north':
        // ?‚ç›´ç§»å?ï¼šheight ?¯ç¸±è»¸ï??‹è?å¾Œç‚º?é€²æ–¹?‘ç??·åº¦ï¼?        vehicle1Length = config1.height
        vehicle2Length = config2.height
        break
    }

    // å¯¦é??“è? = ä¸­å?è·é›¢ - è»?å¾Œå???- è»??å???    const actualSpacing = centerDistance - vehicle1Length / 2 - vehicle2Length / 2

    return actualSpacing
  }

  /**
   * æª¢æŸ¥è©²è??¯å¦?¯æ??¥è??œæ­¢ç·šç?è»?   * ?¨é€”ï??¤æ–·è©²è??¯å¦?¯å??¹å??Œè??“ç?é¦–è?
   */
  isClosestToStopLine(allVehicles) {
    const myDistance = this.vehicle.position?.distance || Infinity

    // ?æ­·?€?‰è?è¼?    for (const other of allVehicles) {
      // ?Œæ–¹?‘å?è»Šé??„å…¶ä»–è?
      if (
        other.id === this.vehicle.id ||
        other.direction !== this.vehicle.direction ||
        other.laneNumber !== this.vehicle.laneNumber
      ) {
        continue
      }

      const otherDistance = other.position?.distance || Infinity

      // å¦‚æ??‰å…¶ä»–è?è·é›¢?œæ­¢ç·šæ›´è¿‘ï??‡æ?ä¸æ˜¯?€?¥è???      if (otherDistance > 0 && otherDistance < myDistance) {
        return false
      }
    }

    return true
  }

  /**
   * æ¸…ç?è³‡æ?ï¼ˆç”¨?¼è?è¼›éŠ·æ¯€?‚ï?
   */
  dispose() {
    // ç°¡å??ˆç¢°?æ§?¶å™¨æ²’æ??€è¦æ??†ç?å¤–éƒ¨è³‡æ?
    // ?ªé?å°‡å??¨ç½®ç©?    this.vehicle = null
    this.trafficController = null
  }
}

// ? ï? ç¢°æ?æª¢æŸ¥ç°¡å–®?´è¦ºï¼?// è·é›¢ < TARGET_SPACING ???œæ­¢?–è?è¡?// è·é›¢ >= TARGET_SPACING ???ªç”±? é€?
